
{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./demo_files"
      ]
    },
    "fetch": {
      "command": "uvx",
      "args": [
        "mcp-server-fetch"
      ]
    },
    "custom_rag": {
      "command": "python",
      "args": [
        "-u",
        "servers/custom_rag/server.py"
      ]
    }
  }
}
